# Copy this file to .env and set your own password before running.
BUGTRACK_DB_URL=jdbc:postgresql://127.0.0.1:5436/bugtrack
BUGTRACK_DB_USERNAME=bugtrack
BUGTRACK_DB_PASSWORD=CHANGE_ME

# --- Fase 7: autenticación JWT (stateless, HS256) ---
# Secret used to sign/verify JWTs. MUST be at least 32 bytes, or the app
# refuses to start. Generate one with: openssl rand -base64 48
AUTH_JWT_SECRET=CHANGE_ME_MIN_32_BYTES
# Token lifetime in hours (optional, default 24).
AUTH_JWT_EXPIRY_HOURS=24
# Admin account seeded ONLY when the users table is empty. Leave blank to skip
# seeding (the app logs a WARN and public auth endpoints stay unusable).
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=CHANGE_ME
